APP_NAME="Tagoloan Community College"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Public website origin for sitemap URLs (no trailing slash). Production: https://tcc.edu.ph
FRONTEND_URL=https://tcc.edu.ph

# Comma-separated origins for the React SPA (no wildcards).
# Local: http://localhost:5173
# Production: https://www.tcc.edu.ph,https://cms.tcc.edu.ph
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Behind nginx/Cloudflare — set to * or comma-separated proxy IPs
# TRUSTED_PROXIES=*

# Sanctum bearer token lifetime in minutes (optional global cap)
# SANCTUM_TOKEN_EXPIRATION=20160

# CMS bearer tokens expire after this many days (0 = no per-token expiry)
CMS_TOKEN_LIFETIME_DAYS=14

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# CMS administrator (created/updated by php artisan db:seed)
CMS_ADMIN_NAME="CMS Administrator"
CMS_ADMIN_EMAIL=cms@tcc.edu.ph
CMS_ADMIN_PASSWORD=password

# Temporary password for new author accounts — triggers a change-password reminder when still in use
CMS_DEFAULT_AUTHOR_PASSWORD=12345678

# Legacy alias — used if CMS_ADMIN_PASSWORD is unset
CMS_SEED_PASSWORD=password

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# TCC AI Assistant (handbook RAG) — keep keys server-side only
OPENAI_API_KEY=
# Optional: second OpenAI account/key with balance — used when primary hits quota/rate limits
OPENAI_API_KEY_FALLBACK=
ASSISTANT_CHAT_MODEL=gpt-4o-mini
# Optional: alternate model tried on same key before switching to OPENAI_API_KEY_FALLBACK
# ASSISTANT_CHAT_MODEL_FALLBACK=gpt-4o-mini
ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
ASSISTANT_MAX_OUTPUT_TOKENS=450
ASSISTANT_RETRIEVAL_TOP_K=4
# Rate-limit retries on primary key before fallback (default 2 retries, 800ms apart)
ASSISTANT_OPENAI_MAX_RETRIES=2
ASSISTANT_OPENAI_RETRY_MS=800

# RAG toolkit (apps/website/rag-toolkit) — php artisan rag:build
# RAG_TOOLKIT_ROOT=
# RAG_TOOLKIT_COLLECTION=default
# RAG_TOOLKIT_CHUNK_MAX_CHARS=1800
# RAG_TOOLKIT_RETRIEVAL_TOP_K=4

VITE_APP_NAME="${APP_NAME}"
